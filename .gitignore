# .gitignore - Build output, local Terraform state, and secrets never enter the repo.


# Dependencies and build output
node_modules/
dist/

# Local Terraform state, plans, and the placeholder zips Terraform writes
.terraform/
*.tfstate*
infra/**/.placeholder-*.zip

# Screenshots the walkthrough check leaves when a run fails
walkthrough-failure-*.png

# Secrets and OS clutter
.env*
.DS_Store
